{
  "name": "conjunction-functions",
  "private": true,
  "description": "Cloud Functions for Conjunction: nearby matching, chat, moderation (TypeSafe), safety and data rights.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:emulator",
    "test:unit": "vitest run --project unit",
    "test:emulator": "bash scripts/emulator-test.sh",
    "eval:moderation": "tsx scripts/eval-moderation.ts",
    "serve": "npm run build && firebase emulators:start --project conjunction-dev --only auth,firestore,functions,storage",
    "deploy": "firebase deploy --only functions,firestore,storage"
  },
  "dependencies": {
    "@google-cloud/vision": "^6.2.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.5",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
