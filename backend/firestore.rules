rules_version = '2';

// Conjunction Firestore rules.
//
// Clients only READ, and only their own data or data of a pair they belong to. Every write goes
// through Cloud Functions (Admin SDK bypasses these rules), so text is moderated and invariants hold.
// Collections not listed here (presence, reports, moderationQueue, rateLimits, bannedIdentities,
// devOutbox, …) fall through to the final deny: no client can read or write them. In particular
// nobody — not even the owner — can read a presence (location) document.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }

    // Own profile, settings, pending moderation state. Other people's profiles are served only by
    // callables (getEncounterCard / getFriendProfile) that check the relationship.
    match /users/{uid} {
      allow get: if isUser(uid);
      allow list, write: if false;
    }

    // Match cards: readable by the two people in the pair. Query with
    // where('uids', 'array-contains', <my uid>).
    match /encounters/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    // My matches.
    match /friends/{uid}/list/{other} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // Chats between matched people; messages readable while the chat is open.
    match /chats/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(pairId)).data.uids
          && get(/databases/$(database)/documents/chats/$(pairId)).data.status == 'open';
        allow write: if false;
      }
    }

    // Who I blocked / snoozed (so the app can show and manage the lists).
    match /blocks/{uid}/list/{other} {
      allow read: if isUser(uid);
      allow write: if false;
    }
    match /snoozes/{uid}/list/{other} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // My own consent records (read-only audit trail).
    match /consents/{uid}/records/{id} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
