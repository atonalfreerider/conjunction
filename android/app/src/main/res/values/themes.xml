<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme behind Compose: dark indigo so no white flash between splash and first frame. -->
    <style name="Theme.Conjunction" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/midnight</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- androidx.core.splashscreen: gold eclipse mark on indigo, then Theme.Conjunction. -->
    <style name="Theme.Conjunction.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/midnight</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.Conjunction</item>
    </style>
</resources>
