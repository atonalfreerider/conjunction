<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer.
     Only the non-sensitive appearance preferences are backed up. Birth data, blood type, consent
     records, cached readings, palm photos, Nearby friends, chats, received photos and the identity
     key are NOT: they stay on this phone (Privacy Policy: birth data never leaves the device;
     the identity key lives in Android Keystore and cannot be backed up anyway). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/ui_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/ui_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
