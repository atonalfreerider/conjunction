<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Neither component exists in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Gallery of the match experience for on-phone checks (no second phone needed). -->
        <activity
            android:name=".debug.MatchGalleryActivity"
            android:exported="true"
            android:theme="@style/Theme.Conjunction" />

        <!-- Bluetooth test persona driven over adb (see P2pTestService). Only callers holding DUMP
             (the adb shell, the system) can start it. -->
        <service
            android:name=".debug.P2pTestService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
